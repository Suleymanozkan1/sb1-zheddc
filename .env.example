# ─────────────────────────────────────────────────────────────
# CryptoArena — development environment (Solana DEVNET)
# Copy to .env:  cp .env.example .env   (scripts/setup.mjs does this for you)
# Never commit a real .env. Production values live in your secret manager.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# Database / cache
DATABASE_URL=postgresql://cryptoarena:cryptoarena@localhost:5432/cryptoarena
DATABASE_URL_TEST=postgresql://cryptoarena:cryptoarena@localhost:5432/cryptoarena_test
REDIS_URL=redis://localhost:6379

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GAME_TICKET_TTL_SECONDS=60
PUBLIC_WEB_ORIGINS=http://localhost:5173,http://localhost:5174
ALLOW_GUESTS=true

# Service ports
API_PORT=3000
GAME_PORT=2567
BLOCKCHAIN_SERVICE_PORT=3100

# Game
GAME_TICK_RATE=60
GAME_PATCH_RATE_MS=50
MAX_PLAYERS_PER_ROOM=50
RANKED_MAX_PLAYERS=12
RANKED_MIN_PLAYERS=2
RANKED_MATCH_SECONDS=600
ARENA_SIZE=10000
NPC_DENSITY=1
DEV_BOTS=6
ARENA_MAP_SEED=1337

# Solana — first deployment MUST be devnet
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=finalized
# true = simulated chain (no RPC, no real tokens). Never allowed in production.
SOLANA_MOCK=false
TREASURY_PUBLIC_KEY=
# Only the blockchain-service reads this. Base58 or JSON byte array. Keep it out of git.
TREASURY_SECRET=
REWARD_TOKEN_MINT=
REWARD_TOKEN_DECIMALS=6
REWARD_TOKEN_SYMBOL=ARENA
DEPOSIT_EXPIRY_MINUTES=20

# Economy limits (token base units; 1 token = 10^REWARD_TOKEN_DECIMALS)
MIN_DEPOSIT=1000000
MAX_DEPOSIT=1000000000000
MIN_WITHDRAWAL=5000000
MAX_WITHDRAWAL=500000000
DAILY_WITHDRAWAL_LIMIT=1000000000
WITHDRAWAL_FEE=100000
WITHDRAWAL_COOLDOWN_SECONDS=3600
WITHDRAWAL_MIN_ACCOUNT_AGE_HOURS=24
WITHDRAWAL_REVIEW_THRESHOLD=200000000
WITHDRAWAL_MAX_ATTEMPTS=8
WITHDRAWAL_RISK_SCORE_REVIEW=50
REWARD_POOL=16000000000
SEASON_REWARD_POOL=1000000000000
USER_DAILY_REWARD_CAP=100000000
KILL_REWARD_BASE=200000
PVP_SAME_VICTIM_COOLDOWN_SECONDS=600
PVP_REWARD_MIN_VICTIM_LEVEL=5
PVP_REPEAT_DECAY_BPS=5000
RANKED_REWARD_BASE=2000000
RANKED_REWARD_MIN_HUMANS=6
RANKED_REWARD_FULL_HUMANS=12
TITAN_REWARD_BASE=5000000
TITAN_MIN_DAMAGE_SHARE_BPS=500
TITAN_REWARDS_PER_USER_DAY=3
# Selling items: gold per rarity (consumables per unit × SELL_CONSUMABLE_BPS), plus a share of upgrade gold
SELL_GOLD_COMMON=12
SELL_GOLD_UNCOMMON=30
SELL_GOLD_RARE=80
SELL_GOLD_EPIC=200
SELL_GOLD_LEGENDARY=500
SELL_GOLD_MYTHIC=1200
SELL_CONSUMABLE_BPS=2500
SELL_UPGRADE_REFUND_BPS=2500
SELL_MAX_ITEMS=100

# Compliance hooks
BLOCKED_COUNTRIES=
MIN_AGE=18
REQUIRE_KYC_FOR_WITHDRAWAL=false

# Web client (Vite exposes only VITE_* variables to the browser — never put secrets here)
VITE_API_URL=
VITE_GAME_URL=ws://localhost:2567
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
