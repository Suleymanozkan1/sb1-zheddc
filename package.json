{
  "name": "cryptoarena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @cryptoarena/api dev",
    "dev:game": "pnpm --filter @cryptoarena/game-server dev",
    "dev:web": "pnpm --filter @cryptoarena/web dev",
    "dev:admin": "pnpm --filter @cryptoarena/admin dev",
    "dev:chain": "pnpm --filter @cryptoarena/blockchain-service dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "build": "pnpm -r build",
    "devnet:setup": "tsx scripts/devnet-setup.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "graph": "node scripts/graph.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "dotenv": "^17.2.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11",
    "@cryptoarena/config": "workspace:*",
    "@cryptoarena/database": "workspace:*",
    "@cryptoarena/economy": "workspace:*",
    "@cryptoarena/game-core": "workspace:*",
    "@cryptoarena/shared": "workspace:*",
    "@cryptoarena/blockchain": "workspace:*",
    "@solana/kit": "^8.3.0",
    "@solana-program/token": "^0.17.0",
    "@solana-program/system": "^0.15.0",
    "@colyseus/sdk": "^0.18.4",
    "@playwright/test": "^1.63.0",
    "pg": "^8.23.0",
    "fastify": "^5.12.5",
    "@cryptoarena/observability": "workspace:*",
    "@cryptoarena/validation": "workspace:*",
    "ioredis": "^5.11.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2"
  }
}
