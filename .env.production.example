# ─────────────────────────────────────────────────────────────
# CryptoArena — PRODUCTION configuration template.
# Do NOT store real values in files: inject them from a secret manager (AWS Secrets Manager,
# GCP Secret Manager, Vault, Doppler, ...). TREASURY_SECRET must only be given to blockchain-service,
# and should be replaced by a KMS/HSM-backed TreasurySigner before holding significant funds.
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@managed-postgres:5432/cryptoarena?sslmode=require
REDIS_URL=rediss://default:PASSWORD@managed-redis:6380

JWT_SECRET=<64+ random characters from the secret manager>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GAME_TICKET_TTL_SECONDS=60
PUBLIC_WEB_ORIGINS=https://play.example.com,https://admin.example.com
COOKIE_DOMAIN=
ALLOW_GUESTS=true
TRUST_PROXY_HOPS=1
GEO_COUNTRY_HEADER=cf-ipcountry

API_PORT=3000
GAME_PORT=2567
BLOCKCHAIN_SERVICE_PORT=3100

GAME_TICK_RATE=60
GAME_PATCH_RATE_MS=50
MAX_PLAYERS_PER_ROOM=50
DEV_BOTS=0

# Keep devnet until a legal/compliance review approves mainnet.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://<dedicated-rpc-provider>
SOLANA_COMMITMENT=finalized
SOLANA_MOCK=false
ALLOW_MAINNET=false
TREASURY_PUBLIC_KEY=
TREASURY_SECRET=
REWARD_TOKEN_MINT=
REWARD_TOKEN_DECIMALS=6
REWARD_TOKEN_SYMBOL=ARENA

MIN_WITHDRAWAL=5000000
MAX_WITHDRAWAL=500000000
DAILY_WITHDRAWAL_LIMIT=1000000000
WITHDRAWAL_FEE=100000
WITHDRAWAL_COOLDOWN_SECONDS=3600
WITHDRAWAL_MIN_ACCOUNT_AGE_HOURS=72
WITHDRAWAL_REVIEW_THRESHOLD=100000000
WITHDRAWAL_RISK_SCORE_REVIEW=20
REWARD_POOL=16000000000
SEASON_REWARD_POOL=1000000000000
USER_DAILY_REWARD_CAP=100000000
PVP_REWARD_MIN_VICTIM_LEVEL=5
PVP_REPEAT_DECAY_BPS=5000
RANKED_REWARD_BASE=2000000
RANKED_REWARD_MIN_HUMANS=6
RANKED_REWARD_FULL_HUMANS=12
TITAN_REWARD_BASE=5000000
TITAN_MIN_DAMAGE_SHARE_BPS=500
TITAN_REWARDS_PER_USER_DAY=3

BLOCKED_COUNTRIES=
MIN_AGE=18
REQUIRE_KYC_FOR_WITHDRAWAL=true

VITE_API_URL=
VITE_GAME_URL=wss://game.example.com
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://<public-read-rpc>
